# Supabase project settings (Project Settings → API).
# Leave blank to run the app in Demo Mode with local seed data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: require a Supabase Auth login for /operations and /hotel.
# Off by default so the hackathon demo flows without a login step.
VITE_REQUIRE_ADMIN_AUTH=false

# NEVER put the service_role key in a VITE_ variable — anything prefixed
# with VITE_ is bundled into the public JavaScript.
